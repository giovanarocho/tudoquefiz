NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Só usada nas rotas de servidor (api/), NUNCA exposta ao navegador
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Mercado Pago - Access Token de produção (ou teste, pra validar antes)
MP_ACCESS_TOKEN=seu-access-token-mercado-pago

# Mercado Pago - "Chave secreta" do webhook (Dashboard → sua aplicação →
# Webhooks → Configurar notificações → Chave secreta). Usada pra confirmar
# que a notificação de pagamento veio mesmo do Mercado Pago.
MP_WEBHOOK_SECRET=sua-chave-secreta-do-webhook

# WhatsApp da loja, só números com DDI (ex: 55 + DDD + número)
NEXT_PUBLIC_WHATSAPP=5548999936071

# URL pública do site depois de publicado (usada no retorno do Mercado Pago)
NEXT_PUBLIC_SITE_URL=https://tudoquefiz.com.br
